# Copia in monitor/.env e riempi. Il file .env non e' versionato.
# In alternativa esporta queste stesse variabili nell'ambiente.

# Token del bot, da @BotFather
TG_TOKEN=

# La tua chat (Guido): ricevi tutto, sempre
TG_CHAT_GUIDO=

# La chat di Rino: usata solo quando l'interruttore qui sotto vale 1
TG_CHAT_RINO=

# L'INTERRUTTORE. 0 = collaudo (il messaggio di Rino arriva a te, marcato).
#                1 = destinatario reale.
TG_DESTINATARIO_REALE=0

# Metti 1 per stampare i messaggi invece di mandarli davvero
TG_FINTO=0

# Nome utente del bot, senza @ (serve al bottone "Collegati al muretto")
TG_BOT_USERNAME=
